{
  "productName": "SSAI-语音控制器",
  "version": "0.8.1",
  "identifier": "app.au05desk.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "SSAI-语音控制器",
        "decorations": false,
        "width": 1020,
        "height": 772,
        "minWidth": 830,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com/repos/eddylu93/SSAI-yuyinkongzhiqi/releases/latest; img-src 'self' asset: data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
